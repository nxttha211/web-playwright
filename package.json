{
  "name": "web-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright UI and API tests for saucedemo.com and dummyjson.com",
  "author": "Natthaphon",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=login --project=chromium",
    "test:headed": "playwright test --headed --project=chromium",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
